# ------------------  INPUTS TO MAIN PROGRAM  -------------------
max_step = 504

amrex.fpe_trap_invalid = 0
amrex.fpe_trap_zero = 1
amrex.fpe_trap_overflow = 1

# PROBLEM SIZE & GEOMETRY
geometry.prob_extent =  5 5 5
amr.n_cell           =  1      1      5

geometry.is_periodic = 0 0 0

xlo.type = "Outflow"
xhi.type = "Outflow"

ylo.type = "Outflow"
yhi.type = "Outflow"

zlo.type      = "Most"
erf.most.z0   =  0.1
erf.most.zref = 0.5
zhi.type = "SlipWall"

# TIME STEP CONTROL
erf.fixed_dt = 1.0
#erf.fixed_mri_dt_ratio = 4
#erf.no_substepping = 1

# DIAGNOSTICS & VERBOSITY
erf.sum_interval   = -1       # timesteps between computing mass
#erf.data_log      = my_data my_1d_data
erf.v              = 1       # verbosity in ERF.cpp
amr.v              = 1       # verbosity in Amr.cpp

# REFINEMENT / REGRIDDING
amr.max_level       = 0       # maximum level number allowed

# CHECKPOINT FILES
erf.check_file      = chk        # root name of checkpoint file
erf.check_int       = 1        # number of timesteps between checkpoints
erf.restart_type    = "native"
# PLOTFILES
erf.plot_file_1     = plt        # prefix of plotfile name
erf.plot_int_1      = 1          # number of timesteps between plotfiles
erf.plot_vars_1     = density rhotheta rhoadv_0 x_velocity y_velocity z_velocity pressure theta scalar temp pres_hse dens_hse pert_pres pert_dens

erf.plot_lsm = true

# SOLVER CHOICE
erf.alpha_T = 0.0
erf.alpha_C = 0.0
erf.use_gravity = true

erf.molec_diff_type = "None"
erf.les_type        = "Smagorinsky"
erf.Cs              = 0.1
#erf.pbl_type        = "MYNN2.5"
#erf.QKE_0           = 0.5

erf.use_terrain = true

erf.moisture_model = "Kessler"

erf.land_surface_model = "SLM"
prob.SLM_num_ref_inputs = 1
prob.SLM_use_inputs = true
prob.SLM_ref_sounding_file = "sndref"
prob.SLM_ref_flux_file = "swlw"
prob.SLM_ref_sst_file = "sfc"
slm.start_time = 209.0
#slm.start_time = 213.5
slm.time_unit = 3600.0 # dt time unit scalar in seconds when interpolating from testing input data

erf.init_type      = "uniform"

# NO CACHE TILING
fabarray.mfiter_tile_size = 1024 1024 1024
