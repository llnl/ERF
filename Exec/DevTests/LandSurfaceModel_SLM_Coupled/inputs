# ------------------  INPUTS TO MAIN PROGRAM  -------------------
max_step = 17280
stop_time = 172800

amrex.fpe_trap_invalid = 0

fabarray.mfiter_tile_size = 2048 1024 2048

# PROBLEM SIZE & GEOMETRY
geometry.prob_lo     = -25600.   0.    0.
geometry.prob_hi     =  25600. 400. 12800.
amr.n_cell           =  128    4    32    # dx=dy=dz=100 m

# periodic in x to match WRF setup
# - as an alternative, could use symmetry at x=0 and outflow at x=25600
#geometry.is_periodic = 1 1 0
#zlo.type = "SlipWall"
#zhi.type = "SlipWall"
geometry.is_periodic = 0 0 0

xlo.type = "Outflow"
xhi.type = "Outflow"

ylo.type = "Outflow"
yhi.type = "Outflow"

zlo.type      = "Most"
erf.most.z0   =  0.1
erf.most.zref = 400.0
zhi.type = "SlipWall"


# TIME STEP CONTROL
#erf.use_native_mri = 1
erf.fixed_dt       = 1.0      # fixed time step [s] -- Straka et al 1993
erf.fixed_fast_dt  = 0.25     # fixed time step [s] -- Straka et al 1993

# DIAGNOSTICS & VERBOSITY
erf.sum_interval   = 1       # timesteps between computing mass
erf.v              = 1       # verbosity in ERF.cpp
amr.v              = 1       # verbosity in Amr.cpp

# REFINEMENT / REGRIDDING
amr.max_level       = 0       # maximum level number allowed

# CHECKPOINT FILES
amr.check_file      = chk        # root name of checkpoint file
amr.check_int       = -1       # number of timesteps between checkpoints
#amr.restart         = chk01000

# PLOTFILES
erf.plot_file_1         = plt        # root name of plotfile
erf.plot_int_1          = 1         # number of timesteps between plotfiles
erf.plot_vars_1         = density rhotheta rhoQ1 rhoQ2 x_velocity y_velocity z_velocity pressure theta temp qt qp qv qc qi qsrc_sw qsrc_lw

#erf.plotfile_type = "netcdf"
erf.plotfile_type = "amrex"
erf.plot_rad = true
erf.plot_lsm = true

# SOLVER CHOICE
erf.use_gravity = true
erf.use_coriolis = false

erf.use_terrain = true
erf.moisture_model = "SAM"
erf.land_surface_model = "SLM"

erf.les_type = "Deardorff"
erf.KE_0 = 0.1 # for Deardorff
#erf.les_type = "None"
#
# diffusion coefficient from Straka, K = 75 m^2/s
#
#erf.molec_diff_type = "ConstantAlpha"
erf.molec_diff_type = "None"
erf.rho0_trans = 1.0 # [kg/m^3], used to convert input diffusivities
erf.dynamicViscosity = 75.0 # [kg/(m-s)] ==> nu = 75.0 m^2/s
erf.alpha_T = 75.0 # [m^2/s]

# ------------------------
# SLM configuration
# ------------------------
# number of soil layers
slm.nsoil = 7
# soil thickness (in m) for each layer (from top layer to bottom)
slm.soil_dz = 0.02 0.04 0.08 0.16 0.32 0.64 1.28

# initial values used over entire grid
slm.landtype0 = 1     # evergreen forest
slm.LAI0 = 3.0        # default leaf area index
slm.clay0 = 34.0      # uniform clay content (%)
slm.sand0 = 10.0      # uniform sand content (%)
slm.sw0 = 0.50        # uniform soil wetness fraction
slm.st0 = 300.0       # uniform soil temperature (K)
slm.tabs_s = 0.0      # surface temperature (K)
slm.t00 = 300.0       # constant offset for sstxy

slm.z0_soil = 0.0387  # baresoil roughness length
slm.mws_mx0 = 50.0    # maximum puddle water storage (mm)
slm.Rc_max  = 5000.0  # maximum stomatal resistance
slm.T_opt   = 298.0   # optimum temperature for transpiration
slm.zref    = 25.0     # height of reference level (m)

#slm.SLM_num_ref_inputs = 1
slm.SLM_use_inputs = false
#slm.SLM_ref_sounding_file = "sndref"
#slm.SLM_ref_flux_file = "swlw"
#slm.SLM_ref_sst_file = "sfc"
#slm.start_time = 209.0
#slm.start_time = 213.5
#slm.time_unit = 1.0 # dt time unit scalar in seconds when interpolating from testing input data

# PROBLEM PARAMETERS (optional)
prob.T_0 = 300.0
prob.U_0 = 0
prob.T_pert = 3
